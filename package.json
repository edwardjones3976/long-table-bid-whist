{
  "name": "the-long-table-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "tsc -b && vite build --configLoader runner && vite build --configLoader runner --config client/vite.config.ts",
    "preview": "vite preview --configLoader runner --host 0.0.0.0",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "dev:server": "tsx server/main.ts",
    "dev:client": "vite --configLoader runner --config client/vite.config.ts",
    "dev:xr": "vite --configLoader runner --config client/vite.config.ts --mode xr",
    "start": "tsx server/main.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@react-three/xr": "^6.6.32",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "0.165.0",
    "tsx": "^4.23.15",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "0.165.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
